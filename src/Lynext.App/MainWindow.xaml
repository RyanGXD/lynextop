<Window x:Class="Lynext.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lynext" Height="760" Width="1180" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="14" Background="#111A33" BorderBrush="#257FEA" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="BrandImage" Visibility="Collapsed" Stretch="UniformToFill"/>
                        <Grid x:Name="BrandPlaceholder">
                            <Ellipse Margin="4" Stroke="#A52DFF" StrokeThickness="2"/>
                            <TextBlock Text="L" FontSize="34" FontWeight="Black" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LYNEXT" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="OPTIMIZER" FontSize="11" FontWeight="Bold" Foreground="#68A9FF" Margin="1,0,0,0"/>
                    <TextBlock Text="Windows performance control center" Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="BUILD 0.1.0 • PREVIEW" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="StatusText" Text="Nenhuma otimização aplicada" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HARDWARE DETECTADO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="CpuText" Text="Processador: analisando..." FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GpuText" Text="Placa de vídeo: analisando..." FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RamText" Text="Memória RAM: analisando..." FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SystemText" Text="Windows: analisando..." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Analisar novamente" VerticalAlignment="Center" Click="RefreshHardware_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="PERFIS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                    <Button Content="Gamer Ultra" Tag="Gamer Ultra" Click="Profile_Click"/>
                    <Button Content="Gamer" Tag="Gamer" Click="Profile_Click"/>
                    <Button Content="Lite" Tag="Lite" Click="Profile_Click"/>
                    <Button Content="Empresarial" Tag="Empresarial" Click="Profile_Click"/>
                    <Button Content="Economia" Tag="Economia" Click="Profile_Click"/>
                    <TextBlock Text="Gamer ativa o Modo de Jogo com reversão própria. Gamer Ultra adiciona uma opção explícita de plano Alto desempenho, se disponível. Lite, Empresarial e Economia continuam em planejamento." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ProfileTitle" Text="Bem-vindo ao Lynext" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="ProfileDescription" Text="Selecione um perfil para ver sua finalidade. A navegação não modifica o Windows." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,20" TextWrapping="Wrap"/>
                        <StackPanel x:Name="WelcomeProfilePanel">
                            <TextBlock Text="Escolha Gamer ou Gamer Ultra para consultar as opções disponíveis. Os perfis Lite, Empresarial e Economia ainda estão em planejamento." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="GamerProfilePanel" Visibility="Collapsed">
                            <TextBlock Text="GAMER • PERFIL EQUILIBRADO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="Modo de Jogo do Windows" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <TextBlock Text="Usa a configuração documentada do Windows para Game Mode no usuário atual. Benefício esperado: o Windows prioriza a experiência de jogo; o ganho de FPS depende do sistema e não é garantido. Risco baixo; requer leitura/gravação do Registro do usuário, sem elevação. Restauração do valor anterior suportada." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="GamerStateText" Text="Estado não confirmado" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ActivateGamerButton" Content="Ativar Gamer" Click="ActivateGamer_Click" IsEnabled="False"/>
                                <Button x:Name="RestoreDefaultsButton" Content="Voltar ao padrão" Click="RestoreDefaults_Click" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Configurações gráficas" Click="OpenGraphicsSettings_Click"/>
                                <Button Content="Aplicativos de inicialização" Click="OpenStartupAppsSettings_Click"/>
                            </StackPanel>
                            <TextBlock Text="Os links abrem as páginas nativas do Windows para análise manual. O Lynext não altera GPUs por jogo nem desativa itens de inicialização." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="GamerUltraProfilePanel" Visibility="Collapsed">
                            <TextBlock Text="GAMER ULTRA • OPÇÕES ADICIONAIS EXPLÍCITAS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="Modo de Jogo do Windows" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <TextBlock Text="Compartilha a opção documentada do Game Mode, com backup e verificação do valor atual. Benefício esperado e limitações são iguais aos do perfil Gamer; não é alegado ganho de FPS." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="GamerUltraStateText" Text="Estado não confirmado" Margin="0,8,0,0"/>
                            <TextBlock Text="Plano Alto desempenho • opcional" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <TextBlock Text="Só é oferecido na ativação se o Windows listar o plano e a consulta confirmar que não há bateria. Pode aumentar consumo, calor e ruído; não há ganho de FPS garantido. O plano original é restaurado somente se o estado ainda corresponder ao aplicado pelo Lynext." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ActivateGamerUltraButton" Content="Ativar Gamer Ultra" Click="ActivateGamerUltra_Click" IsEnabled="False" Background="{StaticResource AccentBrush}" Foreground="#101318" FontWeight="Bold"/>
                                <Button x:Name="RestoreUltraDefaultsButton" Content="Voltar ao padrão" Click="RestoreDefaults_Click" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Configurações gráficas" Click="OpenGraphicsSettings_Click"/>
                                <Button Content="Aplicativos de inicialização" Click="OpenStartupAppsSettings_Click"/>
                            </StackPanel>
                            <TextBlock Text="Esses links abrem as páginas nativas para decisão manual. O Lynext não altera preferências por jogo ou inicialização nesta versão." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="LiteProfilePanel" Visibility="Collapsed">
                            <TextBlock Text="Lite" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Perfil planejado para uma experiência simples e leve. Ainda não possui funções implementadas." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="BusinessProfilePanel" Visibility="Collapsed">
                            <TextBlock Text="Empresarial" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Perfil planejado para uso profissional e estabilidade. Ainda não possui funções implementadas." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="EconomyProfilePanel" Visibility="Collapsed">
                            <TextBlock Text="Economia" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Perfil planejado para consumo e bateria. Ainda não possui funções implementadas." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="GamingToolsPanel" Visibility="Collapsed" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Preparar análise" Click="PrepareAnalysis_Click" Background="{StaticResource AccentBrush}" Foreground="#101318" FontWeight="Bold"/>
                                <Button Content="Ver registro de alterações" Click="History_Click"/>
                                <Button Content="Diagnosticar Store / Xbox / UAC" Click="StoreDiagnostic_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="#12161C" BorderBrush="#303A49" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="ATUALIZAÇÕES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="O Lynext verifica Releases estáveis automaticamente. Atualizadores só são executados após validar versão, arquitetura, HTTPS e SHA-256." Margin="0,6,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações" Click="CheckUpdates_Click"/>
                                    <Button x:Name="InstallUpdateButton" Content="Atualizar agora" Click="InstallUpdate_Click" IsEnabled="False" Visibility="Collapsed" Background="{StaticResource AccentBrush}" Foreground="#101318" FontWeight="Bold"/>
                                    <Button x:Name="LaterUpdateButton" Content="Lembrar depois" Click="LaterUpdate_Click" Visibility="Collapsed"/>
                                    <Button x:Name="OpenReleasesButton" Content="Notas no GitHub" Click="OpenReleases_Click"/>
                                </StackPanel>
                                <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="8" Margin="0,2,0,8" Visibility="Collapsed"/>
                                <Button x:Name="CancelUpdateButton" Content="Cancelar download" Click="CancelUpdate_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="UpdateAvailableText" Text="" Visibility="Collapsed" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="UpdateNotesText" Text="" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="56" Margin="0,4,0,0"/>
                                <TextBlock x:Name="UpdateStatusText" Text="Versão instalada: 0.1.0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="FeedbackText" Text="" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Lynext • Transparência primeiro: nenhuma alteração é aplicada sem confirmação." Foreground="{StaticResource MutedBrush}" Margin="2,16,0,0"/>
    </Grid>
</Window>

