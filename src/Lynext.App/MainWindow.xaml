<Window x:Class="Lynext.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lynext" Height="760" Width="1180" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="14" Background="#111A33" BorderBrush="#257FEA" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="BrandImage" Visibility="Collapsed" Stretch="UniformToFill"/>
                        <Grid x:Name="BrandPlaceholder">
                            <Ellipse Margin="4" Stroke="#A52DFF" StrokeThickness="2"/>
                            <TextBlock Text="L" FontSize="34" FontWeight="Black" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LYNEXT" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="OPTIMIZER" FontSize="11" FontWeight="Bold" Foreground="#68A9FF" Margin="1,0,0,0"/>
                    <TextBlock Text="Windows performance control center" Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="BUILD 0.1.0 • PREVIEW" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="StatusText" Text="Nenhuma otimização aplicada" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HARDWARE DETECTADO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="CpuText" Text="Processador: analisando..." FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GpuText" Text="Placa de vídeo: analisando..." FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RamText" Text="Memória RAM: analisando..." FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SystemText" Text="Windows: analisando..." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Analisar novamente" VerticalAlignment="Center" Click="RefreshHardware_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="PERFIS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                    <Button Content="Gamer Ultra" Tag="Gamer Ultra" Click="Profile_Click"/>
                    <Button Content="Gamer" Tag="Gamer" Click="Profile_Click"/>
                    <Button Content="Lite" Tag="Lite" Click="Profile_Click"/>
                    <Button Content="Empresarial" Tag="Empresarial" Click="Profile_Click"/>
                    <Button Content="Economia" Tag="Economia" Click="Profile_Click"/>
                    <TextBlock Text="Os perfis ainda não aplicam alterações. Nesta fase estamos montando a interface e a detecção de hardware." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="ProfileTitle" Text="Bem-vindo ao Lynext" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="ProfileDescription" Text="Selecione um perfil para ver seu objetivo e preparar a análise." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,20" TextWrapping="Wrap"/>
                    <TextBlock Text="CENTRAL DE AJUSTES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    <Border Background="#12161C" CornerRadius="8" Padding="16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Nenhum ajuste disponível nesta versão" FontWeight="SemiBold"/>
                            <TextBlock Text="Os próximos passos serão criar o catálogo de ajustes com explicação, compatibilidade, risco, estado atual e possibilidade de restauração." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Preparar análise" Click="PrepareAnalysis_Click" Background="{StaticResource AccentBrush}" Foreground="#101318" FontWeight="Bold"/>
                        <Button Content="Ver registro de alterações" Click="History_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="FeedbackText" Text="" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Lynext • Transparência primeiro: nenhuma alteração é aplicada sem confirmação." Foreground="{StaticResource MutedBrush}" Margin="2,16,0,0"/>
    </Grid>
</Window>
